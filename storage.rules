rules_version = '2';

// Tout est refusé pour l'instant. Les règles par chemin (preuves de
// missions, ressources VCF protégées) seront ajoutées avec les modules
// correspondants, en s'appuyant sur le custom claim `role`.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
