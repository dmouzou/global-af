rules_version = '2';

// GLOBAL-AF — règles Firestore (base « global-af-database »).
// Principe : le client LIT ses propres données, mais n'ÉCRIT RIEN sur les
// données sensibles (profil, wallet, ledger, retraits, commissions,
// paiements, audit). Toute écriture passe par les Cloud Functions (Admin SDK),
// qui ignorent ces règles. Le rôle est porté par un custom claim signé
// (request.auth.token.role), posé uniquement côté serveur.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() && request.auth.token.keys().hasAny(['role'])
        ? request.auth.token.role : 'none';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return role() in ['admin', 'super_admin'];
    }
    function isFinance() {
      return role() in ['financial_manager', 'admin', 'super_admin'];
    }
    function isSupport() {
      return role() in ['support', 'admin', 'super_admin'];
    }

    // Configuration publique (taux, délais) : lecture libre, écriture serveur.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /countries/{code} {
      allow read: if true;
      allow write: if false;
    }

    // Profil : lecture par le titulaire et le support/admin.
    match /users/{uid} {
      allow read: if isOwner(uid) || isSupport();
      allow write: if false;
    }
    // Données privées (date de naissance) : titulaire et admin seulement.
    match /userPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Wallet, ledger, retraits : lecture du titulaire ou de la finance.
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isFinance();
      allow write: if false;
    }
    match /ledger/{entryId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isFinance();
      allow write: if false;
    }
    match /withdrawals/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isFinance();
      allow write: if false;
    }
    match /commissions/{id} {
      allow read: if (signedIn()
        && resource.data.beneficiaryUid == request.auth.uid) || isFinance();
      allow write: if false;
    }
    // Compteur quotidien d'appels IA : lecture par le titulaire, écriture serveur.
    match /aiUsage/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isFinance();
      allow write: if false;
    }
    match /refunds/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isFinance();
      allow write: if false;
    }

    // Journaux serveur : jamais accessibles aux membres.
    match /payment_webhooks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /risk_events/{id} {
      allow read: if isFinance();
      allow write: if false;
    }

    // Notifications : le titulaire peut seulement marquer « lu ».
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);
      allow create, delete: if false;
    }

    // Index d'unicité, codes de parrainage, limitation de débit :
    // aucun accès client (lecture comprise : évite l'énumération).
    match /phoneIndex/{id} {
      allow read, write: if false;
    }
    match /referralCodes/{id} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
